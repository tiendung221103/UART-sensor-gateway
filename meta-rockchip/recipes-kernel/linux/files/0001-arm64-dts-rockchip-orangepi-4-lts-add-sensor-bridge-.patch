From: OpenEmbedded <oe.patch@oe>
Date: Thu, 22 Oct 2026 16:10:09 +0700
Subject: [PATCH] arm64: dts: rockchip: orangepi-4-lts: add sensor bridge in
 uart4

---
 arch/arm64/boot/dts/rockchip/rk3399-orangepi-4-lts.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3399-orangepi-4-lts.dts b/arch/arm64/boot/dts/rockchip/rk3399-orangepi-4-lts.dts
index 23ac62ea9b37..9a62d0afed82 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-orangepi-4-lts.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3399-orangepi-4-lts.dts
@@ -473,7 +473,11 @@
 };
 
 &uart4 {
-    status = "okay";
+	status = "okay";    
+	sensor_bridge {
+		compatible = "gateway,sensor-bridge";
+		current-speed = <115200>;
+	};
 };
 
 &vopb {
